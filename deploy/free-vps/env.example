# Hermes gateway secrets for a free VPS.
# bootstrap.sh writes these into $HERMES_HOME/.env (default ~/.hermes/.env,
# mode 600) by prompting on the VM. You can also copy this file there and fill
# it in by hand. Never commit the filled-in file.

# --- Telegram (required) -----------------------------------------------------
# From @BotFather: /newbot → copy the token it replies with.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (ask @userinfobot). Only these ids can use the
# bot; comma-separate several. Leaving it empty lets anyone talk to your agent.
TELEGRAM_ALLOWED_USERS=

# --- Model provider (set at least one) ---------------------------------------
# OpenRouter: https://openrouter.ai/keys . Models ending in ":free" cost nothing
# (rate-limited; a one-time $10 credit raises the daily cap).
OPENROUTER_API_KEY=
# Google AI Studio (Gemini): https://aistudio.google.com/apikey . Free tier is
# small for agent use; fine for light personal traffic.
GOOGLE_API_KEY=
